{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python3 app.py)",
      "Bash(python app.py)",
      "Bash(bash start.sh)",
      "Bash(pip install:*)",
      "Bash(python3 -m venv:*)",
      "Bash(pytest:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(ruff check:*)",
      "Bash(ruff format:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git checkout:*)",
      "Bash(git branch:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr view:*)"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(rm -rf:*)",
      "Bash(rm budget.db)",
      "Bash(rm ./budget.db)",
      "Read(.env)",
      "Read(budget.db)"
    ]
  }
}
