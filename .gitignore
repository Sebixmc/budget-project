# ── Database (contains your actual financial data — never commit this) ─────────
*.db
*.db-shm
*.db-wal

# ── Python ─────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/

# ── Environment / secrets ──────────────────────────────────────────────────────
.env
.env.*

# ── macOS ──────────────────────────────────────────────────────────────────────
.DS_Store
*.DS_Store

# ── Claude Code ─────────────────────────────────────────────────────────────────
# The shared agent infra IS committed (.claude/agents, .claude/commands,
# .claude/settings.json, .claude/launch.json) so every clone gets the same
# guardrails. Only personal/transient session files are ignored:
.claude/settings.local.json
.claude/*.local.json
.claude/projects/
.claude/todos/
.claude/shell-snapshots/
.claude/statsig/
.claude/history.jsonl

# Personal, machine-specific agent notes
CLAUDE.local.md

# ── Uploaded CSV files (may contain account data) ─────────────────────────────
uploads/
*.csv

# ── R leftovers ────────────────────────────────────────────────────────────────
.Rhistory
