# Copy to web/.env.local for local dev, and set the same in Vercel project env vars.
# NEVER commit a filled-in .env* file. See CLAUDE.md hard rule #2.

# --- Public (safe in the browser; RLS gates all data) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- Server-only secret (NEVER prefix with NEXT_PUBLIC_, never ship to client) ---
# In Vercel, add this as an encrypted Environment Variable, not exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
